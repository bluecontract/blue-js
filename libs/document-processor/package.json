{
  "name": "@blue-labs/document-processor",
  "version": "4.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "!dist/package.json"
  ],
  "dependencies": {
    "@blue-labs/bex": "4.1.1",
    "@blue-labs/language": "4.1.1",
    "@blue-labs/shared-utils": "4.1.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluecontract/blue-js.git"
  },
  "peerDependencies": {
    "@blue-repository/types": ">=1.0.0 <2",
    "zod": "^3.20.0"
  }
}
